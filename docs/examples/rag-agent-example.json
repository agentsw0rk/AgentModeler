{
  "version": 1,
  "name": "RAG Support Agent",
  "nodes": [
    {
      "id": "node-1",
      "type": "graph-agent",
      "position": { "x": 400, "y": 200 },
      "data": {
        "name": "SupportAgent",
        "description": "Customer support agent with RAG and tools",
        "systemPrompt": "You are a helpful customer support agent. Use the provided context and tools to answer questions accurately.",
        "modelProvider": "openai",
        "modelId": "gpt-4o",
        "temperature": 0.7,
        "strategyNodes": [
          { "id": "sn-1", "type": "node-start", "position": { "x": 0, "y": 100 }, "data": {} },
          { "id": "sn-2", "type": "node-llm-request", "position": { "x": 200, "y": 100 }, "data": { "label": "llmRequest" } },
          { "id": "sn-3", "type": "node-execute-tool", "position": { "x": 400, "y": 50 }, "data": { "label": "executeTool", "toolName": "CustomerTools" } },
          { "id": "sn-4", "type": "node-llm-send-tool-result", "position": { "x": 600, "y": 50 }, "data": { "label": "sendResult" } },
          { "id": "sn-5", "type": "node-finish", "position": { "x": 400, "y": 200 }, "data": {} }
        ],
        "strategyEdges": [
          { "id": "se-1", "source": "sn-1", "target": "sn-2", "edgeType": "onCondition" },
          { "id": "se-2", "source": "sn-2", "target": "sn-3", "edgeType": "onToolCall" },
          { "id": "se-3", "source": "sn-2", "target": "sn-5", "edgeType": "onAssistantMessage" },
          { "id": "se-4", "source": "sn-3", "target": "sn-4", "edgeType": "onCondition" },
          { "id": "se-5", "source": "sn-4", "target": "sn-3", "edgeType": "onToolCall" },
          { "id": "se-6", "source": "sn-4", "target": "sn-5", "edgeType": "onAssistantMessage" }
        ]
      }
    },
    {
      "id": "node-2",
      "type": "rag",
      "position": { "x": 100, "y": 100 },
      "data": {
        "name": "ProductDocs",
        "embedderProvider": "OpenAI",
        "embedderModel": "TextEmbedding3Large",
        "apiKeyVariable": "OPENAI_API_KEY",
        "storageType": "InMemory",
        "storagePath": "./vector-storage",
        "customStorageClass": "",
        "similarityThreshold": 0.7,
        "filePaths": [
          "./docs/products",
          "./docs/faq.txt"
        ],
        "urlSources": [],
        "maxDocuments": 5,
        "injectAsContext": true,
        "provideAsTool": true,
        "toolDescription": "Search product documentation and FAQ for relevant information"
      }
    },
    {
      "id": "node-3",
      "type": "tool",
      "position": { "x": 100, "y": 350 },
      "data": {
        "name": "CustomerTools",
        "description": "Tools for customer account operations.",
        "functions": [
          {
            "id": "func-1",
            "name": "getCustomerInfo",
            "description": "Returns customer profile information by customer ID.",
            "parameters": [
              {
                "id": "p-1",
                "name": "customerId",
                "type": "Int",
                "description": "The unique identifier of the customer.",
                "required": true
              }
            ],
            "returnType": "String",
            "body": "return \"Customer $customerId: Max Mustermann, Premium Plan, joined 2023-01-15\""
          },
          {
            "id": "func-2",
            "name": "getOrderStatus",
            "description": "Returns the status of an order by order ID.",
            "parameters": [
              {
                "id": "p-2",
                "name": "orderId",
                "type": "String",
                "description": "The order ID to look up.",
                "required": true
              }
            ],
            "returnType": "String",
            "body": "return \"Order $orderId: Shipped, ETA 2026-04-05, tracking: DHL-123456789\""
          },
          {
            "id": "func-3",
            "name": "createTicket",
            "description": "Creates a support ticket and returns the ticket ID.",
            "parameters": [
              {
                "id": "p-3",
                "name": "subject",
                "type": "String",
                "description": "The ticket subject.",
                "required": true
              },
              {
                "id": "p-4",
                "name": "description",
                "type": "String",
                "description": "Detailed description of the issue.",
                "required": true
              }
            ],
            "returnType": "String",
            "body": "return \"Ticket created: TICKET-${System.currentTimeMillis()} - $subject\""
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "id": "edge-1",
      "source": "node-2",
      "target": "node-1"
    },
    {
      "id": "edge-2",
      "source": "node-3",
      "target": "node-1"
    }
  ]
}
