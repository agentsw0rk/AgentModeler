              "inputType": "String",
              "outputType": "String",
              "body": "val intent = llm.writeSession {\n    appendPrompt { user(\"Classify the following request into one of: transfer, analytics, unknown. Request: $input\") }\n    requestLLM()\n}\nintent.content ?: \"unknown\""
            }
